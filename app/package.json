{
  "name": "@ibiz-template/next",
  "private": true,
  "type": "module",
  "version": "0.7.38-alpha.55",
  "scripts": {
    "build:runtime:source": "node scripts/build-source-runtime.mjs",
    "verify:runtime:source": "node scripts/verify-source-runtime.mjs",
    "audit:runtime:types": "node scripts/audit-source-types.mjs",
    "audit:runtime:contracts": "node scripts/audit-source-contracts.mjs",
    "assemble:source:candidate": "node scripts/assemble-source-candidate.mjs",
    "serve:source:candidate": "node scripts/serve-source-candidate.mjs",
    "check:source:candidate": "node scripts/check-source-candidate.mjs",
    "dev": "vite",
    "dev:source": "IBIZ_SOURCE_DEBUG=true IBIZ_LOCAL_API=true vite --host 127.0.0.1 --port 4173",
    "dev:plugins": "vite --config vite.modeling-plugins.config.ts",
    "build:plugins": "vue-tsc --noEmit -p tsconfig.modeling-plugins.json && vite build --config vite.modeling-plugins.config.ts && node scripts/modeling-plugins.mjs build-server",
    "generate:jsonschemas": "node ../../scripts/generate-app-jsonschemas.mjs",
    "verify:jsonschemas": "node ../../scripts/generate-app-jsonschemas.mjs --check",
    "start:plugins": "node scripts/modeling-plugins.mjs start",
    "test:plugins": "vitest run --config vite.modeling-plugins.config.ts",
    "verify:plugins": "node scripts/modeling-plugins.mjs verify",
    "verify:plugins:deployment": "node scripts/modeling-plugins-deployment.mjs",
    "test:plugins:deployment": "node --test tests/modeling-plugins-deployment.harness.mjs",
    "smoke:plugins": "node ../../scripts/harness-modeling-plugins.mjs",
    "smoke:plugins:deployed": "AIBIZ_MODELING_PLUGINS_URL=http://127.0.0.1:32003/modeling-plugins node ../../scripts/harness-modeling-plugins.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:release": "pnpm verify:release && pnpm build && pnpm verify:dist",
    "verify:release": "node scripts/release-harness.mjs",
    "verify:dist": "node scripts/release-harness.mjs --dist",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "compute-pkg": "ibiz-temp compute-pkg -m /root/workspace/iBizPLM/plm-core/src/main/resources/model/cn/ibizlab/plm --app plmmob",
    "download-pkg": "ibiz-temp download-pkg",
    "lint": "eslint 'src/**/*.{ts,vue}'",
    "lint:style": "stylelint 'src/**/*.scss'"
  },
