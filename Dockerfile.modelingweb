ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:alpine
FROM ${NGINX_IMAGE}

USER root

RUN rm -f /etc/nginx/conf.d/default.conf
RUN if grep -Eq '^[[:space:]]*pid[[:space:]]' /etc/nginx/nginx.conf; then \
      sed -i -E 's|^[[:space:]]*pid[[:space:]].*|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf; \
    else \
      sed -i '/^events[[:space:]]*{/i pid /tmp/nginx.pid;' /etc/nginx/nginx.conf; \
    fi
RUN if [ -f /etc/nginx/conf.d/proxy.conf ]; then \
      sed -i -E 's|^[[:space:]]*proxy_temp_path[[:space:]].*|proxy_temp_path /tmp/nginx-proxy-temp 1 2;|' /etc/nginx/conf.d/proxy.conf; \
    fi
RUN mkdir -p \
      /var/cache/nginx/client_temp \
      /var/cache/nginx/proxy_temp \
      /var/cache/nginx/fastcgi_temp \
      /var/cache/nginx/uwsgi_temp \
      /var/cache/nginx/scgi_temp \
      /var/log/nginx \
    && chown -R 101:101 /var/cache/nginx /var/log/nginx
COPY nginx-local.conf /etc/nginx/conf.d/nginx.conf
COPY nginx-native.conf /opt/aibiz/nginx-native.conf
COPY start.sh /start.sh
COPY environment.config /environment.config
COPY --chown=101:101 app/dist/ /dist/

RUN test -s /dist/index.html \
    && test -s /dist/doc/index.html \
    && test -s /dist/doc/script/docsify.js \
    && test -s /dist/environments/environment.js \
    && chmod 0755 /start.sh \
    && chmod -R u+rwX /dist \
    && chown -R 101:101 /etc/nginx/conf.d \
    && chown 101:101 /start.sh /environment.config

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=6 \
  CMD ["wget", "-q", "-O", "/dev/null", "--timeout=3", "http://127.0.0.1:8080/modeldesign/"]

USER 101
ENTRYPOINT ["/start.sh"]
