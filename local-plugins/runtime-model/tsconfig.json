{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "jsxFactory": "h",
    "lib": ["dom", "es2017"],
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2017",
    "strict": true,
    "useDefineForClassFields": false,
    "skipLibCheck": false,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
